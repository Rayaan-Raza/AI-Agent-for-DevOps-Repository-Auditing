# Copy this file to .env and set the values.

# Mandatory. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Default: openai/gpt-oss-120b
LLM_MODEL=

# Optional. low, medium or high. Default: medium (only sent to models that support it)
LLM_REASONING_EFFORT=

# Optional. Default: 40 investigation steps, 900 seconds
MAX_STEPS=
MAX_SECONDS=
