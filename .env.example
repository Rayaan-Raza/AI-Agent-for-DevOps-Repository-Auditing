# Copy this file to .env and set the values.

# Mandatory. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Default: openai/gpt-oss-120b
LLM_MODEL=

# Optional. low, medium or high. Default: low (only sent to models that support it)
LLM_REASONING_EFFORT=

# Optional. Default: 35 investigation steps, 1800 seconds
MAX_STEPS=
MAX_SECONDS=

# Optional. Longest wait for a Groq rate limit before the agent stops, in seconds. Default: 300
LLM_MAX_WAIT_SECONDS=
